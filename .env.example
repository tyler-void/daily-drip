# Copy to .env (mode 600). Bun loads it when run directly; with Docker, Compose
# reads it from the folder that holds compose.yaml. Empty means "use the default".
# The Riot cookie never goes here: it lives in the cookie file (see the spec).

# Path of the cookie file. Default: config/riot-cookie (compose.yaml sets its own)
RIOT_COOKIE_FILE=
# Only if E4 misbehaves, e.g. ap
RIOT_SHARD=
# debug, info, warn or error. Default: info
LOG_LEVEL=
# Log timestamps only, e.g. Europe/Berlin
TZ=
# Ping URL from an external monitor, called after each successful run
HEALTHCHECK_URL=

# Discord (used from build step 4)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
