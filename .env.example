# Copy to .env (mode 600). Bun loads it when run directly; with Docker, Compose
# reads it from the folder that holds compose.yaml. Empty means "use the default".
# The Riot cookie never goes here: it lives in the cookie file (see the spec).

# Path of the cookie file. Default: config/riot-cookie (compose.yaml sets its own)
RIOT_COOKIE_FILE=
# Only if E4 misbehaves, e.g. ap
RIOT_SHARD=
# debug, info, warn or error. Default: info
LOG_LEVEL=
# Log timestamps only, e.g. Europe/Berlin
TZ=
# Ping URL from an external monitor, called after each successful run
HEALTHCHECK_URL=
# Lets other members of the server /link their own Riot account. It seals their sign-in tokens
# at rest. 32 random bytes, base64: openssl rand -base64 32. Empty: only the owner is served.
# Losing it means every member has to /link again.
TOKEN_KEY=
# Match recaps after games. "on" needs the Presence Intent switched on in the Discord
# Developer Portal (Bot -> Privileged Gateway Intents); without it the bot starts without recaps.
RECAP=off
# Channel for recaps; empty means the shop channel
RECAP_CHANNEL_ID=
# Queues to recap; empty means competitive,unrated,swiftplay
RECAP_QUEUES=
# Match recaps for friends who aren't linked: a free key from https://api.henrikdev.xyz/dashboard/
# Empty: recaps cover only the owner and linked members.
HENRIK_API_KEY=

# Discord (used from build step 4)
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_CHANNEL_ID=
DISCORD_OWNER_ID=
